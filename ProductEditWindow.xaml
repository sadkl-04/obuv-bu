<Window x:Class="WpfApp1.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="680" Width="470" MinHeight="450" FontFamily="Times New Roman" FontSize="16"
        WindowStartupLocation="CenterOwner" Background="White" Icon="/WpfApp1;component/Images/Icon.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Артикул" Margin="0,8,0,2"/>
            <TextBox x:Name="Article" Text="{Binding Article, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Наименование" Margin="0,8,0,2"/>
            <TextBox x:Name="ProductName" Text="{Binding Name, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Единица измерения" Margin="0,8,0,2"/>
            <TextBox x:Name="Unit" Text="{Binding Unit, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Цена, ₽" Margin="0,8,0,2"/>
            <TextBox x:Name="Price" Text="{Binding Price, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Поставщик" Margin="0,8,0,2"/>
            <TextBox x:Name="Supplier" Text="{Binding Supplier, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Производитель" Margin="0,8,0,2"/>
            <TextBox x:Name="Manufacturer" Text="{Binding Manufacturer, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Категория" Margin="0,8,0,2"/>
            <TextBox x:Name="Category" Text="{Binding Category, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Скидка, %" Margin="0,8,0,2"/>
            <TextBox x:Name="Discount" Text="{Binding Discount, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Количество на складе" Margin="0,8,0,2"/>
            <TextBox x:Name="Stock" Text="{Binding Stock, Mode=OneWay}" Padding="4"/>
            <TextBlock Text="Описание" Margin="0,8,0,2"/>
            <TextBox x:Name="Description" Text="{Binding Description, Mode=OneWay}" Padding="4"/>
            <Button Content="Сохранить" Click="BtnSave_Click" IsDefault="True" Background="#00FA9A" Padding="10" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>

