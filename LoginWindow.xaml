<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="400" Width="400" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" Background="White" Icon="/WpfApp1;component/Images/Icon.ico">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ООО «Обувь» — вход" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="TxtLogin" Margin="0,0,0,10" Padding="5"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,20" Padding="5"/>
            <Button Content="Войти" IsDefault="True" Background="#00FA9A" Click="BtnLogin_Click" Padding="10" Margin="0,0,0,10"/>
            <Button Content="Войти как гость" Click="BtnGuest_Click" Padding="10" Background="#FFBEBEBE"/>
        </StackPanel>
    </Grid>
</Window>

