<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — каталог" Height="690" Width="1100" MinWidth="780" MinHeight="480" FontFamily="Times New Roman" FontSize="16"
        WindowStartupLocation="CenterOwner" Background="White" Icon="/WpfApp1;component/Images/Icon.ico">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Background="#7FFF00" LastChildFill="False" Margin="0,0,0,12">
            <Image Source="/WpfApp1;component/Images/Icon.png" Width="42" Height="42" Margin="12,6" Stretch="Uniform"/>
            <TextBlock Text="ООО «Обувь»" FontSize="25" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Выйти" Click="BtnExit_Click" Padding="10,4" Margin="12,8"/>
            <TextBlock x:Name="TxtUser" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <TabControl x:Name="MainTabControl">
            <TabItem Header="Товары">
                <DockPanel Margin="8">
                    <StackPanel x:Name="FilterPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Поиск" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Width="185" Padding="4" TextChanged="TxtSearch_TextChanged"/>
                        <ComboBox x:Name="CmbSupplier" Width="165" Margin="8,0" SelectionChanged="CmbSort_SelectionChanged"/>
                        <ComboBox x:Name="CmbSort" Width="190" SelectionChanged="CmbSort_SelectionChanged">
                            <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                            <ComboBoxItem Content="Остаток ↑"/>
                            <ComboBoxItem Content="Остаток ↓"/>
                            <ComboBoxItem Content="Цена со скидкой ↑"/>
                            <ComboBoxItem Content="Цена со скидкой ↓"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="AdminPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
<Button Content="Добавить" Click="BtnAdd_Click" Padding="10,4" Margin="6,0,0,0"/>
<Button Content="Редактировать" Click="BtnEdit_Click" Padding="10,4" Margin="6,0,0,0"/>
<Button Content="Удалить" Click="BtnDelete_Click" Padding="10,4" Margin="6,0,0,0"/>
</StackPanel>
                    <ListView x:Name="LvProducts" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stock}" Value="0">
                                        <Setter Property="Background" Value="#ADD8E6"/>
                                    </DataTrigger>
                                <DataTrigger Binding="{Binding HasLargeDiscount}" Value="True"><Setter Property="Background" Value="#2E8B57"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding FullPhotoPath}" Width="92" Height="86" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Margin="0,2,15,2">
                                        <TextBlock FontWeight="Bold" FontSize="18">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Article, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category, StringFormat=Категория — {0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Manufacturer, StringFormat=Производитель — {0}}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Supplier, StringFormat=Поставщик — {0}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,2">
                                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:0.00} ₽}" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:0.00} ₽}" Foreground="DarkRed" TextDecorations="Strikethrough">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Discount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Discount, StringFormat=Скидка — {0}%}"/>
                                        <TextBlock>
                                            <Run Text="На складе "/><Run Text="{Binding Stock, Mode=OneWay}"/>
                                            <Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="Заказы" x:Name="TabOrders">
                <DockPanel Margin="8">
                    <StackPanel x:Name="OrderAdminPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
<Button Content="Добавить" Click="BtnAddOrder_Click" Padding="10,4" Margin="6,0,0,0"/>
<Button Content="Редактировать" Click="BtnEditOrder_Click" Padding="10,4" Margin="6,0,0,0"/>
<Button Content="Удалить" Click="BtnDeleteOrder_Click" Padding="10,4" Margin="6,0,0,0"/>
</StackPanel>
                    <ListView x:Name="LvOrders">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="№" DisplayMemberBinding="{Binding Id}" Width="45"/>
                                <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="85"/>
                                <GridViewColumn Header="Товары" DisplayMemberBinding="{Binding Composition}" Width="195"/>
                                <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding OrderDate, StringFormat=\{0:dd.MM.yyyy\}, TargetNullValue=—}" Width="100"/>
                                <GridViewColumn Header="Доставка" DisplayMemberBinding="{Binding DeliveryDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <GridViewColumn Header="Код" DisplayMemberBinding="{Binding PickupCode}" Width="55"/>
                                <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding User.FullName}" Width="205"/>
                                <GridViewColumn Header="Пункт выдачи" DisplayMemberBinding="{Binding PickupPoint.Address}" Width="290"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>


