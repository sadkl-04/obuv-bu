<Window x:Class="WpfApp1.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="620" Width="510" FontFamily="Times New Roman" FontSize="16"
        WindowStartupLocation="CenterOwner" Background="White" Icon="/WpfApp1;component/Images/Icon.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Клиент"/>
            <ComboBox x:Name="Client" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,2,0,8"/>
            <TextBlock Text="Пункт выдачи"/>
            <ComboBox x:Name="Point" DisplayMemberPath="Address" SelectedValuePath="Id" Margin="0,2,0,8"/>
            <TextBlock Text="Дата заказа"/>
            <DatePicker x:Name="Placed" Margin="0,2,0,8"/>
            <TextBlock Text="Дата доставки"/>
            <DatePicker x:Name="Delivery" Margin="0,2,0,8"/>
            <TextBlock Text="Статус"/>
            <ComboBox x:Name="Status" Margin="0,2,0,0"/>
            <TextBlock Text="Код получения" Margin="0,8,0,2"/>
            <TextBox x:Name="Code" Padding="4"/>
            <TextBlock Text="Товары (по одному на строку: артикул, количество)" Margin="0,8,0,2"/>
            <TextBox x:Name="Lines" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" Padding="4"/>
            <Button Content="Сохранить" Click="BtnSave_Click" Background="#00FA9A" Padding="10" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>

